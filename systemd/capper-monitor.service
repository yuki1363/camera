[Unit]
Description=Capper Box Line Detection Monitor
# ネットワークや他のサービスの起動は待たない（監視はネットワークなしで動き、スマホ画面は
# 0.0.0.0 で待ち受けるのでWi-Fiが後から立ち上がってもつながる）。待つと起動が十数秒遅れる。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
# 実行ユーザー（rootでは動かさない）。インストール時に自分のユーザー名へ置き換える:
#   sed "s/^User=.*/User=$USER/" systemd/capper-monitor.service | sudo tee /etc/systemd/system/capper-monitor.service
# このユーザーが /etc/capper-monitor と /var/log/capper-monitor に書き込める必要がある。
User=pi
ExecStart=/opt/capper-monitor/.venv/bin/python -m capper_monitor --config /etc/capper-monitor/config.yaml
WorkingDirectory=/opt/capper-monitor
Restart=on-failure
RestartSec=5
WatchdogSec=30
SupplementaryGroups=gpio video

[Install]
WantedBy=multi-user.target
